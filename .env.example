# Create your own .env from this file. Never commit it or paste these values into chat.
TRADING212_API_KEY=replace-with-your-api-key-id
TRADING212_API_SECRET=replace-with-your-secret-key

# Use demo while validating the connection. Change to live only when ready to read your live account.
TRADING212_ENVIRONMENT=demo

# Optional: a network timeout in milliseconds (default 15000; max 60000).
TRADING212_TIMEOUT_MS=15000
